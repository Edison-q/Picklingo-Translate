<Window x:Class="Picklingo.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Picklingo"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Grid Margin="14">
        <Border Background="#FFFFFF"
                CornerRadius="10"
                BorderBrush="#E1E4E8"
                BorderThickness="1"
                Padding="14,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.22" Direction="270" Color="#000000"/>
            </Border.Effect>

            <StackPanel MinWidth="220" MaxWidth="400">
                <!-- 原文（灰色小字，方便对照；超长可滚动） -->
                <ScrollViewer MaxHeight="54" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="SourceText"
                               FontSize="12"
                               Foreground="#8B929A"
                               TextWrapping="Wrap"/>
                </ScrollViewer>

                <!-- 分隔线 -->
                <Border Height="1" Background="#EFF1F3" Margin="0,9,0,9"/>

                <!-- 译文（大字；超长可滚动） -->
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="ResultText"
                               FontSize="15"
                               Foreground="#1F2329"
                               TextWrapping="Wrap"
                               LineHeight="22"/>
                </ScrollViewer>

                <!-- 底部：状态 + 复制按钮 -->
                <Grid Margin="0,10,0,0">
                    <TextBlock x:Name="StatusText"
                               FontSize="11"
                               Foreground="#AEB4BB"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>

                    <Button x:Name="CopyButton"
                            Content="复制"
                            HorizontalAlignment="Right"
                            Padding="12,4"
                            FontSize="12"
                            Foreground="#2F6FED"
                            Background="#EFF4FF"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CopyButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#E2EBFF"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
